<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景 v2：一枚火苗（外焰深橙 + 内焰亮金），
  播放三角用 evenOdd 挖空 —— 洞里透出的是 background 层的深炭色。
  只有两个元素、一个整体，小尺寸下依然清晰。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 外焰：尖端 → 左缘 → 底部半圆 → 右缘，中央挖播放三角 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,31.1
            C54,41.8 36.5,46.5 36.5,59.5
            A17.5,17.5 0 0,0 71.5,59.5
            C71.5,46.5 54,41.8 54,31.1
            Z
            M51.0,53.1 L59.9,58.9 L51.0,64.7 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="31"
                android:endX="54"
                android:endY="77">
                <item android:color="#FFFFB85C" android:offset="0.0" />
                <item android:color="#FFFF7A18" android:offset="0.45" />
                <item android:color="#FFC63F00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 内焰：更亮的一层，底部对齐外焰下部 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,46.2
            C54,53.3 45.1,53.9 45.1,62.4
            A8.9,8.9 0 0,0 62.9,62.4
            C62.9,53.9 54,53.3 54,46.2
            Z
            M51.0,53.1 L59.9,58.9 L51.0,64.7 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="46"
                android:endX="54"
                android:endY="71">
                <item android:color="#FFFFE9BC" android:offset="0.0" />
                <item android:color="#FFFFC24A" android:offset="0.5" />
                <item android:color="#FFFF8A2B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
