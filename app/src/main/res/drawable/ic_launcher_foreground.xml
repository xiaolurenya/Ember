<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：一枚火苗（外焰深橙 + 内焰亮金），播放三角用 evenOdd 挖空，
  洞里透出 background 层的深炭色。

  ⚠️ 居中口径（v1.1.3，别再凭感觉调坐标，改之前先跑 _gen_icon2.py 看数值）：
    外焰的**面积质心**在 (54.000, 58.586)（不是包围盒中心 54.05 —— 火苗下半部是
    半圆球，质量压在下面，质心比几何中心低 4.5）。
    判据：**外焰质心 = 内焰质心 = 三角质心** 三点同心。
      · 内焰 = 外焰以 (54, 58.586) 为原点缩放 0.55 → 质心天然与外焰重合
      · 三角质心 = (54, 58.586) → 指右三角的质心在 x0+w/3，所以 x0 = 54 - w/3 = 51
        （这正是播放键的经典光学居中：包围盒偏右一点，看起来才居中）
    实测四周间距：到外焰轮廓 9.97 / 11.33 / 11.72（极差 1.75，改之前是 4.7）
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 外焰：尖端 → 左缘 → 底部半圆 → 右缘，中央挖播放三角 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,31.1
            C54,41.8 36.5,46.5 36.5,59.5
            A17.5,17.5 0 0,0 71.5,59.5
            C71.5,46.5 54,41.8 54,31.1
            Z
            M51,52.74 L60,58.59 L51,64.44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="31.1"
                android:endX="54"
                android:endY="77">
                <item android:color="#FFFFB85C" android:offset="0.0" />
                <item android:color="#FFFF7A18" android:offset="0.45" />
                <item android:color="#FFC63F00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 内焰：外焰 ×0.55 的同心缩放，同样挖掉三角 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M54,43.47
            C54,49.35 44.38,51.94 44.38,59.09
            A9.625,9.625 0 0,0 63.62,59.09
            C63.62,51.94 54,49.35 54,43.47
            Z
            M51,52.74 L60,58.59 L51,64.44 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="43.47"
                android:endX="54"
                android:endY="68.71">
                <item android:color="#FFFFE9BC" android:offset="0.0" />
                <item android:color="#FFFFC24A" android:offset="0.5" />
                <item android:color="#FFFF8A2B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
