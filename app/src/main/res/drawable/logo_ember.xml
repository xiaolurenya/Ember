<?xml version="1.0" encoding="utf-8"?>
<!--
  Splash / 应用内用的品牌标（512 viewport，**透明背景**）。
  Splash 页本身就是 #0B0908 深炭色，播放三角的洞会透出它 —— 这样品牌标
  在任何深色页面上都没有「方框感」，火苗是浮着的。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- 外焰（中央镂空播放三角） -->
    <path
        android:fillType="evenOdd"
        android:pathData="M256,108
            C256,180 138,212 138,300
            A118,118 0 0,0 374,300
            C374,212 256,180 256,108
            Z
            M236,257 L296,296 L236,335 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="256"
                android:startY="108"
                android:endX="256"
                android:endY="418">
                <item android:color="#FFFFB85C" android:offset="0.0" />
                <item android:color="#FFFF7A18" android:offset="0.45" />
                <item android:color="#FFC63F00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 内焰 -->
    <path
        android:fillType="evenOdd"
        android:pathData="M256,210
            C256,258 196,262 196,320
            A60,60 0 0,0 316,320
            C316,262 256,258 256,210
            Z
            M236,257 L296,296 L236,335 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="256"
                android:startY="210"
                android:endX="256"
                android:endY="380">
                <item android:color="#FFFFE9BC" android:offset="0.0" />
                <item android:color="#FFFFC24A" android:offset="0.5" />
                <item android:color="#FFFF8A2B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
